# ============================================================
# Server Configuration
# ============================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================================
# Database (PostgreSQL)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=ai_intent
DB_NAME_TEST=ai_intent_test

# ============================================================
# Default (AI Models)
# ============================================================
DEFAULT_PROVIDER=openai
# ============================================================
# Ollama (AI Models)
# ============================================================
OLLAMA_BASE_URL=https://api-hrms.duluin.com/api/v2/ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct-q4_0
OLLAMA_NATURAL_MODEL=citra


# ============================================================
# OpenAI (AI Models)
# ============================================================
DASHSCOPE_API_KEY=sk-5d79743b12f24fd9abf595ca718d8b70't3s
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen3.5-flash
DASHSCOPE_NATURAL_MODEL=qwen3.5-flash
DASHSCOPE_EMBED_MODEL=text-embedding-v3

# ============================================================
# Vector DB (ChromaDB)
# ============================================================
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=intents

# ============================================================
# Intent Management & Logic
# ============================================================
# Digunakan untuk pengambilan data dari Vector DB
INTENT_SIMILARITY_THRESHOLD=0.75
INTENT_TOP_K=3

# Digunakan untuk logika pengambilan keputusan (Intent Decision)
# Menentukan kapan AI harus yakin atau butuh klarifikasi
INTENT_CONFIDENT_THRESHOLD=0.5
INTENT_CLARIFY_THRESHOLD=0.5

# ============================================================
# External APIs
# ============================================================
WEATHER_API_KEY=your_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5