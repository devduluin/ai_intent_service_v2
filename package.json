{
  "name": "ai-intent-api",
  "version": "1.0.0",
  "description": "AI Intent Pipeline: Nomic Embed + Intent Matching + API Dispatch + LLM Naturalization",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "chromadb": "^1.9.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.0",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "node-cache": "^5.1.2",
    "ollama": "^0.5.0",
    "openai": "^6.37.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino-pretty": "^11.0.0",
    "sequelize": "^6.37.0",
    "uuid": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/node-cache": "^4.1.3",
    "@types/validator": "^13.0.0",
    "sequelize-cli": "^6.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
