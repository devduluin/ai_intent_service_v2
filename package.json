{
  "name": "ai-intent-api",
  "version": "1.0.0",
  "description": "AI Intent Pipeline: Nomic Embed + Intent Matching + API Dispatch + LLM Naturalization",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "qa:phase1": "tsx scripts/qa-phase1-regression-smoke.ts",
    "qa:skill-param-schema": "tsx scripts/skill-param-schema-phase7-smoke.ts",
    "qa:comparison-temporal": "tsx scripts/comparison-temporal-splitter-smoke.ts",
    "qa:comparison-stage": "tsx scripts/comparison-stage-smoke.ts",
    "qa:memory-recall": "tsx scripts/memory-recall-smoke.ts",
    "qa:episodic-topic": "tsx scripts/episodic-topic-resolver-smoke.ts",
    "qa:active-offer": "tsx scripts/active-offer-smoke.ts",
    "qa:automation-runtime": "tsx scripts/automation-runtime-phase1-smoke.ts",
    "qa:automation-runtime-full": "tsx scripts/automation-runtime-full-smoke.ts",
    "qa:automation-pretest": "tsx scripts/automation-pretest-smoke.ts",
    "qa:automation-reference": "tsx scripts/automation-reference-smoke.ts",
    "qa:automation-v3-7": "tsx scripts/automation-v3-7-upgrade-smoke.ts",
    "qa:automation-planner-gate": "tsx scripts/automation-planner-gate-smoke.ts",
    "qa:confirmation-runtime": "tsx scripts/confirmation-runtime-smoke.ts",
    "qa:confirmation-prompt": "tsx scripts/confirmation-prompt-smoke.ts",
    "qa:god-mode-manager": "tsx scripts/god-mode-manager-smoke.ts",
    "qa:llm-option-resolution": "tsx scripts/llm-option-resolution-smoke.ts",
    "qa:temporal-parser": "tsx scripts/temporal-expression-parser-smoke.ts",
    "qa:perception": "tsx scripts/perception-phase7-smoke.ts",
    "qa:perception-comprehensive": "tsx scripts/perception-comprehensive-test.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "amqplib": "^2.0.1",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "chromadb": "^1.9.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "ollama": "^0.5.0",
    "openai": "^6.37.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino-pretty": "^11.0.0",
    "sequelize": "^6.37.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/node-cache": "^4.1.3",
    "@types/node-cron": "^3.0.11",
    "@types/validator": "^13.0.0",
    "@types/ws": "^8.18.1",
    "sequelize-cli": "^6.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
